# Generate a 32-byte encryption key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store locally in .dev.vars (ignored) and in the hosting provider secret manager.
KEY_ENCRYPTION_SECRET=replace-with-base64-32-byte-key
# Optional shared server credential; prefer owner-scoped encrypted connection via Settings.
# META_API_KEY=
# Shared operator key is restricted to these authenticated household-owner emails.
# META_SHARED_EMAILS=owner@example.com
# LOCAL DEVELOPMENT ONLY. Never set on a public deployment.
LOCAL_DEMO_AUTH=0
